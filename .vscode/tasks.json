{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codex: audit (read-only)",
      "type": "process",
      "command": "codex",
      "args": ["--config", "sandbox_mode=\"read-only\"", "--config", "approval_policy=\"never\""],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
    },
    {
      "label": "Codex: develop (workspace-write)",
      "type": "process",
      "command": "codex",
      "args": ["--config", "sandbox_mode=\"workspace-write\"", "--config", "approval_policy=\"on-request\""],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
    }
  ]
}
