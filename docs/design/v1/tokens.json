    "parkButton": {
      "height": 56,
      "iconBox": 36
    },
    "spectrum": {
      "height": 56,
      "heightCompact": 32,
      "bars": 56
    },
    "scale": {
      "height": 84,
      "inset": 24,
      "tickMinor": 8,
      "tickMajor": 14,
      "tickWidth": 2,
      "markStation": [
        3,
        24
      ],
      "markPreset": [
        5,
        36
      ],
      "confirmed": [8, 48],
      "preview": [8, 56],
      "slider": 4,
      "sliderKnob": 16
    },
    "plate": {
      "height": 64,
      "heightCompact": 56,
      "presetWidth": 160,
      "catalogColumns": 5
    },
    "setSwitcher": {
      "width": 148,
      "height": 64
    },
    "loupe": {
      "height": 96,
      "gapToScale": 12,
      "stations": 7,
      "stationsNarrow": 5,
      "pointer": 12,
      "selectedGrow": 1.6
    },
    "rds": {
      "height": 22
    },
    "editorRow": {
      "height": 56,
      "stride": 64,
      "iconButton": 48
    },
    "parkMenu": {
      "width": 236,
      "item": 52,
      "back": 56
    },
    "chip": {
      "height": 48
    },
    "segment": {
      "width": 180,
      "height": 56
    },
    "paletteCard": {
      "height": 132
    },
    "banner": {
      "button": 52
    },
    "iconButton": {
      "size": 48
    },
    "icon": {
      "s": 18,
      "m": 22,
      "l": 26,
      "xl": 40
    }
  },
  "space": {
    "window": 16,
    "section": 12,
    "plateGap": 8,
    "cardPadding": 18,
    "parkContent": [
      20,
      24
    ],
    "ribbonFade": 28
  },
  "radius": {
    "s": 8,
    "m": 12,
    "l": 14,
    "xl": 16,
    "pill": 999
  },
  "line": {
    "edge": 1.5,
    "stroke": 2,
    "focus": 3,
    "focusOffset": 2,
    "pressedRing": 3,
    "drop": 4,
    "tick": 2
  },
  "shadow": {
    "raised": {
      "y": 14,
      "blur": 30,
      "colorToken": "shadow",
      "use": "Лупа"
    },
    "drag": {
      "y": 16,
      "blur": 32,
      "colorToken": "shadow",
      "use": "Перетаскиваемая плашка"
    },
    "toast": {
      "y": 10,
      "blur": 24,
      "colorToken": "shadow",
      "use": "Уведомление"
    }
  },
  "state": {
    "pressed": {
      "ring": 3,
      "ringColor": "currentColor",
      "overlay": "rgba(128,128,128,0.30)",
      "scale": 0.98,
      "offsetY": 1,
      "animationMs": 0
    },
    "disabled": {
      "background": "surface",
      "foreground": "disabledText"
    },
    "active": {
      "background": "accent",
      "foreground": "onAccent"
    },
    "transition": {
      "background": "accentSoft",
      "border": "dashed 2 accentText"
    },
    "drag": {
      "scale": 1.04,
      "rotateDeg": -1.5,
      "border": "solid 2 accent",
      "shadow": "drag"
    }
  },
  "motion": {
    "ribbonMs": 300,
    "spectrumPeriodMs": [
      2400,
      3600
    ],
    "rdsMarqueeMs": 18000,
    "rdsMarqueeRepeat": 2,
    "transitionDemoMs": 650
  },
  "breakpoint": {
    "compactHeight": 540,
    "narrowLoupeWidth": 1000
  }
}
