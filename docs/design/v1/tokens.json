  "font": {
    "family": {
      "ui": {
        "name": "Golos Text",
        "license": "SIL OFL 1.1",
        "fallback": [
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "name": "JetBrains Mono",
        "license": "SIL OFL 1.1",
        "fallback": [
          "monospace"
        ]
      }
    },
    "numeric": "tabular-nums для частот и счётчиков",
    "style": {
      "freq": {
        "size": 60,
        "lineHeight": 60,
        "weight": 600,
        "letterSpacing": -0.02,
        "family": "ui",
        "use": "Частота в Эфире"
      },
      "band": {
        "size": 32,
        "lineHeight": 32,
        "weight": 800,
        "family": "ui",
        "use": "Активный диапазон на кнопке FM/AM"
      },
      "bandBack": {
        "size": 16,
        "lineHeight": 16,
        "weight": 800,
        "family": "ui",
        "opacity": 0.85,
        "blurDp": 0.6,
        "use": "Неактивный диапазон за знаком"
      },
      "title": {
        "size": 26,
        "lineHeight": 32,
        "weight": 600,
        "family": "ui",
        "use": "Имя Станции"
      },
      "heading": {
        "size": 24,
        "lineHeight": 30,
        "weight": 700,
        "family": "ui",
        "use": "Заголовок экрана стоянки"
      },
      "loupeSel": {
        "size": 22,
        "lineHeight": 26,
        "weight": 700,
        "family": "ui",
        "use": "Выбранная Станция в Лупе"
      },
      "loupe": {
        "size": 18,
        "lineHeight": 22,
        "weight": 700,
        "family": "ui",
        "use": "Соседние Станции в Лупе"
      },
      "cardTitle": {
        "size": 18,
        "lineHeight": 24,
        "weight": 600,
        "family": "ui",
        "use": "Заголовок карточки"
      },
      "plate": {
        "size": 17,
        "lineHeight": 22,
        "weight": 600,
        "family": "ui",
        "use": "Имя на плашке Станции"
      },
      "body": {
        "size": 16,
        "lineHeight": 22,
        "weight": 500,
        "family": "ui",
        "use": "Строки, кнопки, статус"
      },
      "button": {
        "size": 15,
        "lineHeight": 20,
        "weight": 700,
        "family": "ui",
        "use": "Подписи Старт/Стоп, кнопок"
      },
      "label": {
        "size": 14,
        "lineHeight": 18,
        "weight": 600,
        "family": "ui",
        "use": "Частота на плашке, подписи"
      },
      "caption": {
        "size": 13,
        "lineHeight": 16,
        "weight": 500,
        "family": "ui",
        "use": "Минимум; только вторичное"
      },
      "indicator": {
        "size": 12,
        "lineHeight": 16,
        "weight": 700,
        "family": "ui",
        "letterSpacing": 0.04,
        "use": "Значок «РАЗРАБОТЧИК»"
      },
      "mono": {
        "size": 13,
        "lineHeight": 20,
        "weight": 400,
        "family": "mono",
        "use": "Поток кадров"
      },
      "monoButton": {
        "size": 14,
        "lineHeight": 20,
        "weight": 500,
        "family": "mono",
        "use": "Кнопки команд"
      }
    }
  },
