{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git worktree *)",
      "Bash(sha256sum *)",
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(gh issue *)",
      "Bash(gh label list *)",
      "Bash(graphify *)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  }
}
